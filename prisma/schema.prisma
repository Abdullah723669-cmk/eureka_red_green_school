generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Student {
  id           Int      @id @default(autoincrement())
  studentId    Int      @unique
  name         String
  grade        String
  guardian     String
  status       String   @default("Active")
  feesPaid     Float    @default(0)
  attendedDays Int      @default(20)
  totalDays    Int      @default(20)
  joiningDate  String   @default("2024-01-10")
  leavingDate  String?
  createdAt    DateTime @default(now())
}

model Staff {
  id          Int      @id @default(autoincrement())
  staffId     Int      @unique
  name        String
  role        String
  phone       String
  joiningDate String   @default("2023-01-15")
  leavingDate String?
  createdAt   DateTime @default(now())
}

model Grade {
  id        Int      @id @default(autoincrement())
  studentId Int
  subject   String
  score     Int
  term      String
  createdAt DateTime @default(now())
}

model Transaction {
  id          Int      @id @default(autoincrement())
  studentName String
  studentId   Int
  amount      Float
  type        String
  date        String
  createdAt   DateTime @default(now())
}

model Expense {
  id        Int      @id @default(autoincrement())
  category  String
  amount    Float
  date      String
  notes     String?
  createdAt DateTime @default(now())
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  date      String
  createdAt DateTime @default(now())
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      String   @unique
  records   String
  createdAt DateTime @default(now())
}

model Lesson {
  id          Int      @id @default(autoincrement())
  grade       String
  subject     String
  title       String
  description String?
  fileType    String   @default("link")
  fileUrl     String?
  postedBy    String   @default("Teacher")
  date        String
  createdAt   DateTime @default(now())
}
